# 复制为 .env 并填写真实值（.env 已被 .gitignore 忽略，不会提交）
# 生成随机 SECRET_KEY：python -c "import secrets; print(secrets.token_hex(32))"
# 生成随机 POSTGRES_PASSWORD：python -c "import secrets; print(secrets.token_hex(16))"

# SQLAlchemy 连接串
# 方式一（推荐，生产）：项目自带的本地 PostgreSQL 容器（docker-compose 的 db 服务，不对外暴露端口）
DATABASE_URL=postgresql+psycopg://cobebuddy:POSTGRES_PASSWORD@db:5432/cobebuddy
# 方式二（云端）：Supabase pooler 示例，直接连接地址（直连 db.xxx.supabase.co 可能仅 IPv6）
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# 方式三（本地开发，无 Docker 时）：SQLite
# DATABASE_URL=sqlite:///instance/judge.db

# 本地 PostgreSQL（docker-compose 中 db 服务使用；必须与 DATABASE_URL 中的密码一致）
POSTGRES_USER=cobebuddy
POSTGRES_PASSWORD=change-me-to-a-random-string
POSTGRES_DB=cobebuddy

# 会话加密密钥，生产必须改为随机字符串
SECRET_KEY=change-me-to-a-random-string

# 判题并发（2G 内存服务器建议 2，默认 4）
JUDGE_MAX_CONCURRENCY=2

# 教师注册码（建议生产环境修改）
TEACHER_INVITE_CODE=teacher2024
